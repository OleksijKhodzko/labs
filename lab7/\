from typing import Self, Callable

class SearchTree:
    def __init__(self,
                 value: str | None = None,
                 left: Self | None = None,
                 right: Self | None = None,
                 ) -> None:
        self.value = value
        self.left = left
        self.right = right
        self.ancestor = None

    @property
    def left(self) -> Self:
        return self._left

    @left.setter
    def left(self, new: Self | None) -> None:
        self._left = new
        if new is not None:
            new.ancestor = self

    @property
    def right(self) -> Self:
        return self._right

    @right.setter
    def right(self, new: Self | None) -> None:
        self._right = new
        if new is not None:
            new.ancestor = self

    def __repr__(self) -> str:
        return self.value

    def __hash__(self) -> str:
        return hash(str(self))

    @staticmethod
    def repr_level(level: list[Self], init = False) -> str:
        if len(level) == 0:
            return ""
        res = ""
        next_level = []
        for node in level:
            if node is None:
                break
            res += node.value + "  "
            next_level += node.left, node.right
        res += (("\n| \\\n" if len(next_level) > 0 else "") 
                + SearchTree.repr_level(next_level))
        return res

    def __str__(self) -> str:
        return SearchTree.repr_level([self], init = True)

    def __lt__(self, other: Self | str) -> bool:
        if type(other) is str:
            return self.value < other
        return self.value < other.value

    def __gt__(self, other: Self | str) -> bool:
        if type(other) is str:
            return self.value > other
        return self.value > other.value

    def __eq__(self, other: Self | str) -> bool:
        if type(other) is str:
            return self.value == other
        return self.value == other.value




    def sift_down(self) -> None:
        if self.right is None and self.left is None:
            return 
        if self.left is None:
            self.value, self.right.value = (
                    self.right.value, self.value)
            self.right.sift_down()
        elif self.right is None:
            self.value, self.left.value = (
                    self.left.value, self.value)
            self.left.sift_down()
        elif self.left > self.right:
            if self.value > self.left:
                self.value, self.left.value = (
                        self.left.value, self.value)
                self.left.sift_down()
        else:
            if self.value > self.right:
                self.value, self.right.value = (
                        self.right.value, self.value)
                self.right.sift_down()

    def sift_up(self) -> None:
        if self.ancestor is None:
            return
        if self.ancestor > self:
            self.value, self.ancestor.value = (
                    self.ancestor.value, self.value
                    )
            self.ancestor.sift_up()

    @classmethod
    def LRN(cls, tree: Self,
            change_function: Callable,
            ) -> None:
        if tree.left: cls.LRN(tree.left, change_function)
        if tree.right: cls.LRN(tree.right, change_function)
        change_function(tree) 

    @classmethod
    def LNR(cls, tree: Self,
            change_function: Callable,
            ) -> None:
        if tree.left: cls.LRN(tree.left, change_function)
        change_function(tree) 
        if tree.right: cls.LRN(tree.right, change_function)


    @property
    def leaves(self) -> list[Self]:
        leaves = []
        def f(x: Self) -> None:
            if not (x.left or x.right):
                leaves.append(x)
        self.LRN(self, f)
        return leaves

